# Copia in .env SOLO per prove locali. NON committare mai .env (è in .gitignore).
# In produzione questi valori stanno nei Secrets/Variables di GitHub, non nel repository.

# --- Pipeline (GitHub Actions, lato server) ---
DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-0-<regione>.pooler.supabase.com:5432/postgres   # secret
DATABASE_CA=            # opzionale: certificato CA PEM di Supabase
SITE_URL=https://<utente>.github.io/<repo>/                                                           # variable
SMTP_HOST=              # secret (es. server SMTP del provider scelto)
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=              # secret
SMTP_FROM="Anesthesia & Critical Care Digest <digest@tuo-dominio.example>"
SMTP_REPLY_TO=
NCBI_EMAIL=             # raccomandato da NCBI per l'uso delle E-utilities
NCBI_API_KEY=           # opzionale: alza il limite di richieste PubMed
EMAIL_DAILY_LIMIT=100   # tetto prudente: impostalo al limite REALE del tuo provider
SEND_ALLOWLIST=         # fase di prova: se valorizzato (virgole) si invia SOLO a questi indirizzi

# --- Web app (build; solo valori PUBBLICI) ---
VITE_SUPABASE_URL=https://<ref>.supabase.co
VITE_SUPABASE_ANON_KEY=<anon key: pubblica, protetta da RLS>
VITE_TURNSTILE_SITE_KEY=   # opzionale: site key Cloudflare Turnstile (la secret key va solo nel pannello Supabase)
# VITE_ENABLE_DEMO=1       # SOLO per npm run build:demo (modalità demo locale, mai in produzione)
