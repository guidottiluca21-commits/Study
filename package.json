{
  "name": "anesthesia-cc-digest",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Digest settimanale personalizzato di letteratura in anestesia e terapia intensiva, con percorso Core Knowledge. Stack a costo zero.",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "pipeline": "tsx src/pipeline/cli.ts",
    "db:migrate": "tsx src/pipeline/cli.ts migrate",
    "db:seed": "tsx src/pipeline/cli.ts seed",
    "curriculum:verify": "tsx src/pipeline/cli.ts verify-curriculum",
    "build:demo": "VITE_ENABLE_DEMO=1 vite build --outDir ../../dist-demo",
    "test:e2e": "npm run build:demo && vitest run -c vitest.e2e.config.ts",
    "test:live": "NODE_USE_ENV_PROXY=1 vitest run -c vitest.live.config.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "UNLICENSED",
  "dependencies": {
    "@supabase/supabase-js": "^2.117.3",
    "fast-xml-parser": "^5.11.2",
    "nodemailer": "^10.1.1",
    "pg": "^8.23.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.10",
    "@types/mailparser": "^3.9.0",
    "@types/node": "^26.6.5",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@types/smtp-server": "^3.5.13",
    "@vitejs/plugin-react": "^6.1.2",
    "axe-core": "^4.14.0",
    "mailparser": "^3.9.39",
    "playwright-core": "^1.64.1",
    "smtp-server": "^3.19.22",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.4"
  }
}